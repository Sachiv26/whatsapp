# --- Meta WhatsApp Cloud API credentials ---
# Permanent access token (System User token from Business Manager > Users > System Users)
WHATSAPP_ACCESS_TOKEN=your_permanent_token_here
# Phone number ID of your WhatsApp business number (shown in WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WhatsApp Business Account (WABA) ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# Custom string YOU choose. Must match the "Verify token" you set in the Meta dashboard.
WEBHOOK_VERIFY_TOKEN=your_custom_verify_token

# --- App settings ---
PORT=3000
GRAPH_API_VERSION=v21.0